<%# locals: (form:, form_id: nil, **_locals) %>

<div class="p-2 space-y-3">
  <% Transaction.owners.keys.each do |owner| %>
    <div class="flex items-center gap-3" data-filter-name="<%= owner %>">
      <%= form.check_box :owners,
                         {
                           multiple: true,
                           checked: @q[:owners]&.include?(owner),
                           class: "checkbox checkbox--light",
                           form: form_id
                         },
                         owner,
                         nil %>
      <%= form.label :owners, owner.humanize, value: owner, class: "text-sm text-primary" %>
    </div>
  <% end %>
</div>
