<%# locals: (account:) %>

<%= render "accounts/searches/form", account: account %>

<ul id="account-search-filters" class="flex items-center flex-wrap gap-2 mb-4">
  <% @q.reject { |key| key.in?([ "amount_operator", "use_statement_cycles" ]) }.each do |param_key, param_value| %>
    <% unless param_value.blank? %>
      <% if param_key == "amount" %>
        <% amount_operator = case @q[:amount_operator]
                             when "equal"
                               t("transactions.search.search.equal_to")
                             when "greater"
                               t("transactions.search.search.greater_than")
                             when "less"
                               t("transactions.search.search.less_than")
                             else
                               @q[:amount_operator]
                             end %>
        <%= render partial: "accounts/searches/filters/badge",
                   locals: { account: account, param_key: "amount", param_value: "#{amount_operator} #{param_value}" } %>
      <% else %>
        <% Array(param_value).each do |value| %>
          <%= render partial: "accounts/searches/filters/badge",
                     locals: { account: account, param_key: param_key, param_value: value } %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>

  <% if ActiveModel::Type::Boolean.new.cast(@q[:use_statement_cycles]) %>
    <%= render partial: "accounts/searches/filters/badge",
               locals: { account: account, param_key: "use_statement_cycles", param_value: t("accounts.show.activity.monthly_statement") } %>
  <% end %>
</ul>
