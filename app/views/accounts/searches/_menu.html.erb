<%# locals: (form:, account:) %>

<%= render DS::Tabs.new(
  variant: :unstyled,
  active_tab: account_activity_default_filter(account)[:key],
  active_btn_classes: "bg-surface text-primary",
  inactive_btn_classes: "text-secondary hover:bg-container-inset"
) do |tabs| %>
  <div id="account-filters-menu" class="flex flex-col md:flex-row h-[50vh] lg:max-h-auto z-10 md:h-80 w-full md:w-[540px] top-12 right-0 overflow-hidden">
    <%= tabs.with_nav(classes: "shrink-0 flex w-full md:w-44 flex-row md:flex-col items-start p-3 text-sm font-medium text-secondary border-b md:border-b-0 md:border-r border-secondary overflow-x-auto md:overflow-x-visible") do |nav| %>
      <% account_activity_search_filters(account).each do |filter| %>
        <%= nav.with_btn(id: filter[:key], label: filter[:label], classes: "w-full px-3 py-2 flex gap-2 items-center rounded-md") do %>
          <%= icon(filter[:icon]) %>
          <%= tag.span(filter[:label], class: "text-sm font-medium") %>
        <% end %>
      <% end %>
    <% end %>

    <div class="flex flex-col grow overflow-y-auto">
      <div class="grow p-3 border-b border-secondary overflow-y-auto">
        <% account_activity_search_filters(account).each do |filter| %>
          <%= tabs.with_panel(tab_id: filter[:key]) do %>
            <% if filter[:key] == "date_filter" %>
              <%= render partial: account_activity_search_filter_partial_path(filter),
                         locals: { form: form, account: account, form_id: "entries-search" } %>
            <% elsif filter[:key] == "status_filter" %>
              <%= render partial: account_activity_search_filter_partial_path(filter),
                         locals: { form: form, form_id: "entries-search" } %>
            <% else %>
              <%= render partial: account_activity_search_filter_partial_path(filter),
                         locals: { form: form, form_id: "entries-search" } %>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <div class="flex justify-between items-center gap-2 bg-container p-3 shrink-0">
        <div>
          <% if @q.present? %>
            <%= render DS::Link.new(
              text: t("accounts.show.activity.clear_filters"),
              variant: "ghost",
              href: account_path(account, tab: "activity")
            ) %>
          <% end %>
        </div>

        <div>
          <%= render DS::Button.new(text: t("accounts.show.activity.cancel"), type: "button", variant: "ghost", data: { action: "DS--menu#close" }) %>
          <%= render DS::Button.new(text: t("accounts.show.activity.apply"), type: "submit", form: "entries-search") %>
        </div>
      </div>
    </div>
  </div>
<% end %>
