<%# locals: (form:, form_id: nil, **_locals) %>

<div class="p-2 space-y-3">
  <div class="flex items-center gap-3" data-filter-name="confirmed">
    <%= form.check_box :status,
                       {
                         multiple: true,
                         checked: @q[:status]&.include?("confirmed"),
                         class: "checkbox checkbox--light",
                         form: form_id
                       },
                       "confirmed",
                       nil %>
    <%= form.label :status, t("accounts.show.activity.confirmed"), value: "confirmed", class: "text-sm text-primary" %>
  </div>

  <div class="flex items-center gap-3" data-filter-name="pending">
    <%= form.check_box :status,
                       {
                         multiple: true,
                         checked: @q[:status]&.include?("pending"),
                         class: "checkbox checkbox--light",
                         form: form_id
                       },
                       "pending",
                       nil %>
    <%= form.label :status, t("accounts.show.activity.pending"), value: "pending", class: "text-sm text-primary" %>
  </div>
</div>
