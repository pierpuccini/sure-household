<% content_for :page_header do %>
  <div class="space-y-1 mb-6">
    <h1 class="text-xl lg:text-3xl font-medium text-primary">Monthly summary</h1>
    <p class="text-sm lg:text-base text-secondary">A spreadsheet-style overview for <%= @month.strftime("%B %Y") %>.</p>
  </div>
<% end %>

<div class="space-y-6 pb-6 lg:pb-12">
  <section class="bg-container rounded-xl shadow-border-xs p-4">
    <%= form_with url: monthly_summary_path, method: :get, class: "flex items-end gap-3" do |form| %>
      <%= form.month_field :month, value: @month.strftime("%Y-%m"), label: "Month" %>
      <%= form.submit "Update" %>
    <% end %>
  </section>

  <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="bg-container rounded-xl shadow-border-xs p-4">
      <p class="text-sm text-secondary">Income</p>
      <p class="text-xl font-semibold text-primary"><%= format_money(Money.new(@summary.income_total, Current.family.currency)) %></p>
    </div>
    <div class="bg-container rounded-xl shadow-border-xs p-4">
      <p class="text-sm text-secondary">Expenses</p>
      <p class="text-xl font-semibold text-primary"><%= format_money(Money.new(@summary.expense_total, Current.family.currency)) %></p>
    </div>
    <div class="bg-container rounded-xl shadow-border-xs p-4">
      <p class="text-sm text-secondary">Net / savings snapshot</p>
      <p class="text-xl font-semibold <%= @summary.net_total.negative? ? "text-red-600" : "text-primary" %>"><%= format_money(Money.new(@summary.net_total, Current.family.currency)) %></p>
    </div>
  </section>

  <section class="bg-container rounded-xl shadow-border-xs p-4 space-y-3">
    <h2 class="text-base font-medium text-primary">Spending by owner</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <% @summary.owner_totals.each do |row| %>
        <div class="rounded-lg border border-secondary p-3">
          <p class="text-sm text-secondary"><%= row.owner.humanize %></p>
          <p class="text-lg font-medium text-primary"><%= format_money(Money.new(row.amount, Current.family.currency)) %></p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="bg-container rounded-xl shadow-border-xs p-4 space-y-3">
    <h2 class="text-base font-medium text-primary">Totals by account</h2>
    <div class="space-y-2">
      <% @summary.account_totals.each do |row| %>
        <div class="flex items-center justify-between rounded-lg border border-secondary px-3 py-2">
          <span class="text-sm text-primary"><%= row.account.name %></span>
          <span class="text-sm font-medium text-primary"><%= format_money(Money.new(row.amount, row.account.currency || Current.family.currency)) %></span>
        </div>
      <% end %>
    </div>
  </section>

  <section class="bg-container rounded-xl shadow-border-xs p-4 space-y-3">
    <h2 class="text-base font-medium text-primary">Credit card statement cycles</h2>
    <div class="space-y-3">
      <% @summary.credit_card_cycles.each do |row| %>
        <div class="rounded-lg border border-secondary p-3 space-y-1">
          <div class="flex items-center justify-between gap-3">
            <span class="font-medium text-primary"><%= row.account.name %></span>
            <span class="text-sm font-medium text-primary"><%= format_money(Money.new(row.amount, row.account.currency || Current.family.currency)) %></span>
          </div>
          <p class="text-sm text-secondary">
            <%= row.cycle.start_date.strftime("%b %-d") %> to <%= row.cycle.end_date.strftime("%b %-d, %Y") %>
          </p>
          <p class="text-xs text-secondary"><%= pluralize(row.transactions.count, "transaction") %> in statement window</p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="bg-container rounded-xl shadow-border-xs p-4 space-y-3">
    <h2 class="text-base font-medium text-primary">Recurring expenses</h2>
    <div class="space-y-2">
      <% @summary.recurring_statuses.each do |row| %>
        <div class="flex items-center justify-between rounded-lg border border-secondary px-3 py-2">
          <span class="text-sm text-primary"><%= row.recurring_transaction.name.presence || row.recurring_transaction.merchant&.name %></span>
          <span class="text-xs font-medium <%= row.paid ? "text-green-600" : "text-amber-600" %>"><%= row.paid ? "Paid" : "Pending" %></span>
        </div>
      <% end %>
    </div>
  </section>

  <section class="bg-container rounded-xl shadow-border-xs p-4 space-y-2">
    <h2 class="text-base font-medium text-primary">Budget snapshot</h2>
    <p class="text-sm text-secondary">Budgeted spending: <%= format_money(Money.new(@summary.budget.budgeted_spending || 0, Current.family.currency)) %></p>
    <p class="text-sm text-secondary">Actual spending: <%= format_money(Money.new(@summary.budget.actual_spending, Current.family.currency)) %></p>
    <p class="text-sm text-secondary">Available to spend: <%= format_money(Money.new(@summary.budget.available_to_spend, Current.family.currency)) %></p>
  </section>
</div>
